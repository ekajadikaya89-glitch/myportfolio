# Canonical site URL used for sitemap, robots.txt, and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional public email shown in Contact (with 1-click copy), Footer, and Resume
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional scheduling URL shown on Contact (e.g. https://cal.com/your-handle)
NEXT_PUBLIC_CALENDAR_URL=

# Optional static resume PDF inside /public (e.g. /resume/eka-prasetyo.pdf)
# When unset, resume CTAs link to the printable /resume page
NEXT_PUBLIC_RESUME_FILE=

# Server-only HTTPS webhook or Formspree endpoint (e.g. https://formspree.io/f/xxxxxxxx)
# When unset, the contact form displays an explicit setup notice instead of faking delivery
CONTACT_FORM_ENDPOINT=

# Optional server-only LLM provider key to upgrade /api/assistant from
# Deterministic Grounded Retrieval to Grounded RAG + LLM synthesis
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
